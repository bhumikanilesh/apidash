{
  "id": "nytimes.com_top_stories",
  "info": {
    "base_url": "http://api.nytimes.com/svc/topstories/v2",
    "description": "The Top Stories API returns a list of articles and associated images currently on the specified section.  Support JSON and JSONP.",
    "source": "apis.guru",
    "tags": [
      "image-generation"
    ],
    "title": "Top Stories",
    "version": "2.0.0"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{TOP_STORIES_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{TOP_STORIES_API_KEY}}"
      },
      "method": "GET",
      "name": "Top Stories",
      "note": "Replace {{TOP_STORIES_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "http://api.nytimes.com/svc/topstories/v2/{{SECTION}}.{{FORMAT}}"
    }
  ]
}
{
  "id": "amazonaws.com_ec2-instance-connect",
  "info": {
    "base_url": "http://ec2-instance-connect.{region}.amazonaws.com",
    "description": "Pushes an SSH public key to the specified EC2 instance. The key remains for 60 seconds, which gives you 60 seconds to establish a serial console connection to the instance using SSH. For more...",
    "source": "apis.guru",
    "tags": [
      "ai",
      "communication"
    ],
    "title": "AWS EC2 Instance Connect",
    "version": "2018-04-02"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "AvailabilityZone": {},
        "InstanceId": {},
        "InstanceOSUser": {},
        "SSHPublicKey": {}
      },
      "body_json": {
        "AvailabilityZone": {},
        "InstanceId": {},
        "InstanceOSUser": {},
        "SSHPublicKey": {}
      },
      "body_text": "{\"InstanceId\": {}, \"InstanceOSUser\": {}, \"SSHPublicKey\": {}, \"AvailabilityZone\": {}}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{AWS_EC2_INSTANCE_CONNECT_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{AWS_EC2_INSTANCE_CONNECT_API_KEY}}"
      },
      "method": "POST",
      "name": "POST /#X-Amz-Target=AWSEC2InstanceConnectService.SendSSHPublicKey",
      "note": "Replace {{AWS_EC2_INSTANCE_CONNECT_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "http://ec2-instance-connect.{{REGION}}.amazonaws.com/#X-Amz-Target=AWSEC2InstanceConnectService.SendSSHPublicKey"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "InstanceId": {},
        "SSHPublicKey": {},
        "SerialPort": {}
      },
      "body_json": {
        "InstanceId": {},
        "SSHPublicKey": {},
        "SerialPort": {}
      },
      "body_text": "{\"InstanceId\": {}, \"SerialPort\": {}, \"SSHPublicKey\": {}}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{AWS_EC2_INSTANCE_CONNECT_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{AWS_EC2_INSTANCE_CONNECT_API_KEY}}"
      },
      "method": "POST",
      "name": "POST /#X-Amz-Target=AWSEC2InstanceConnectService.SendSerialConsoleSSHPublicKey",
      "note": "Replace {{AWS_EC2_INSTANCE_CONNECT_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "http://ec2-instance-connect.{{REGION}}.amazonaws.com/#X-Amz-Target=AWSEC2InstanceConnectService.SendSerialConsoleSSHPublicKey"
    }
  ]
}
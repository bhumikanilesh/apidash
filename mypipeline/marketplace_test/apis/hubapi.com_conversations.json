{
  "id": "hubapi.com_conversations",
  "info": {
    "base_url": "https://api.hubapi.com/",
    "description": "Generates a new visitor identification token. This token will be unique every time this endpoint is called, even if called with the same email address. This token is temporary and will expire after...",
    "source": "apis.guru",
    "tags": [
      "ai",
      "communication",
      "maps",
      "text-generation"
    ],
    "title": "Visitor Identification",
    "version": "v3"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "email": "visitor-email@example.com",
        "firstName": "Gob",
        "lastName": "Bluth"
      },
      "body_json": {
        "email": "visitor-email@example.com",
        "firstName": "Gob",
        "lastName": "Bluth"
      },
      "body_text": "{\"email\": \"visitor-email@example.com\", \"firstName\": \"Gob\", \"lastName\": \"Bluth\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{VISITOR_IDENTIFICATION_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{VISITOR_IDENTIFICATION_API_KEY}}"
      },
      "method": "POST",
      "name": "Generate a token",
      "note": "Replace {{VISITOR_IDENTIFICATION_API_KEY}} with your API key",
      "url": "https://api.hubapi.com//conversations/v3/visitor-identification/tokens/create"
    }
  ]
}
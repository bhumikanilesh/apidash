{
  "id": "amazonaws.com_sso",
  "info": {
    "base_url": "http://portal.sso.{region}.amazonaws.com",
    "description": "Removes the locally stored SSO tokens from the client-side cache and sends an API call to the IAM Identity Center service to invalidate the corresponding server-side IAM Identity Center sign in...",
    "source": "apis.guru",
    "tags": [
      "ai"
    ],
    "title": "AWS Single Sign-On",
    "version": "2019-06-10"

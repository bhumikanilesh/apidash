{
  "id": "hubapi.com_analytics",
  "info": {
    "base_url": "https://api.hubapi.com/",
    "description": "Endpoint to send an instance of a behavioral event",
    "source": "apis.guru",
    "tags": [
      "other"
    ],
    "title": "Custom Behavioral Events API",
    "version": "v3"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "email": "",
        "eventName": "",
        "objectId": "",
        "occurredAt": "",
        "properties": {},
        "utk": ""
      },
      "body_json": {
        "email": "",
        "eventName": "",
        "objectId": "",
        "occurredAt": "",
        "properties": {},
        "utk": ""
      },
      "body_text": "{\"email\": \"\", \"eventName\": \"\", \"objectId\": \"\", \"occurredAt\": \"\", \"properties\": {}, \"utk\": \"\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{CUSTOM_BEHAVIORAL_EVENTS_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{CUSTOM_BEHAVIORAL_EVENTS_API_KEY}}"
      },
      "method": "POST",
      "name": "Sends Custom Behavioral Event",
      "note": "Replace {{CUSTOM_BEHAVIORAL_EVENTS_API_KEY}} with your API key",
      "url": "https://api.hubapi.com//events/v3/send"
    }
  ]

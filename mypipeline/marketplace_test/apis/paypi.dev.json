{
  "id": "paypi.dev",
  "info": {
    "base_url": "https://ev.apis.paypi.dev",
    "description": "This request send's a code to the given email address, which should be returned to check it is correct.",
    "source": "apis.guru",
    "tags": [
      "ai",
      "code-generation",
      "communication",
      "maps"
    ],
    "title": "EmailVerify",
    "version": "1.0.0"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "code": 123456,
        "email": "test@test.com"
      },
      "body_json": {
        "code": 123456,
        "email": "test@test.com"
      },
      "body_text": "{\"code\": 123456, \"email\": \"test@test.com\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "Authorization",
          "value": "Bearer {{EMAILVERIFY_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Authorization": "Bearer {{EMAILVERIFY_API_KEY}}",
        "Content-Type": "application/json"
      },
      "method": "POST",
      "name": "Check verification code",
      "note": "Replace {{EMAILVERIFY_API_KEY}} with your API key",
      "url": "https://ev.apis.paypi.dev/checkCode"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "email": ""
      },
      "body_json": {
        "email": ""
      },
      "body_text": "{\"email\": \"\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "Authorization",
          "value": "Bearer {{EMAILVERIFY_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Authorization": "Bearer {{EMAILVERIFY_API_KEY}}",
        "Content-Type": "application/json"
      },
      "method": "POST",
      "name": "Send verification code",
      "note": "Replace {{EMAILVERIFY_API_KEY}} with your API key",
      "url": "https://ev.apis.paypi.dev/sendCode"
    }
  ]
}
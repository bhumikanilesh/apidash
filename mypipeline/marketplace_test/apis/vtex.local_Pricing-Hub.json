{
  "id": "vtex.local_Pricing-Hub",
  "info": {
    "base_url": "https://vtex.local",
    "description": "This route facilitates setting up an external price source in Pricing Hub. It also allows you to activate or deactivate that source in a given account. \r\n\r\n>ℹ️ This feature is in closed beta,...",
    "source": "apis.guru",
    "tags": [
      "ai"
    ],
    "title": "Pricing Hub",
    "version": "1.0"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "UtmCampaign": "summer",
        "UtmInternalCampaign": "sale",
        "UtmMedium": "social",
        "UtmSource": "facebook",
        "email": "customer@email.com",
        "items": [
          {
            "brandId": "2000000",
            "categoriesIds": [
              "1"
            ],
            "index": 0,
            "priceTableIds": [],
            "quantity": 1,
            "sellerId": "1",
            "skuId": "13"
          }
        ],
        "salesChannel": "1"
      },
      "body_json": {
        "UtmCampaign": "summer",
        "UtmInternalCampaign": "sale",
        "UtmMedium": "social",
        "UtmSource": "facebook",
        "email": "customer@email.com",
        "items": [
          {
            "brandId": "2000000",
            "categoriesIds": [
              "1"
            ],
            "index": 0,
            "priceTableIds": [],
            "quantity": 1,
            "sellerId": "1",
            "skuId": "13"
          }
        ],
        "salesChannel": "1"
      },
      "body_text": "{\"UtmCampaign\": \"summer\", \"UtmInternalCampaign\": \"sale\", \"UtmMedium\": \"social\", \"UtmSource\": \"facebook\", \"email\": \"customer@email.com\", \"items\": [{\"brandId\": \"2000000\", \"categoriesIds\": [\"1\"], \"index\": 0, \"priceTableIds\": [], \"quantity\": 1, \"sellerId\": \"1\", \"skuId\": \"13\"}], \"salesChannel\": \"1\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{PRICING_HUB_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{PRICING_HUB_API_KEY}}"
      },
      "method": "POST",
      "name": "Get Prices",
      "note": "Replace {{PRICING_HUB_API_KEY}} with your API key",
      "url": "https://vtex.local/api/pricing-hub/prices"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "active": true,
        "appName": "apiexamples_app_name"
      },
      "body_json": {
        "active": true,
        "appName": "apiexamples_app_name"
      },
      "body_text": "{\"active\": true, \"appName\": \"apiexamples_app_name\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{PRICING_HUB_API_KEY}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "{{PRICING_HUB_API_KEY}}"
      },
      "method": "PUT",
      "name": "Configure External Price Source",
      "note": "Replace {{PRICING_HUB_API_KEY}} with your API key",
      "url": "https://vtex.local/config"
    }
  ]
}
{
  "id": "va.gov_forms",
  "info": {
    "base_url": "https://sandbox-api.va.gov/services/va_forms/{version}",
    "description": "Returns a single form and the full revision history",
    "source": "apis.guru",
    "tags": [
      "image-generation"
    ],
    "title": "VA Forms",
    "version": "0.0.0"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{VA_FORMS_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{VA_FORMS_API_KEY}}"
      },
      "method": "GET",
      "name": "Returns all VA Forms and their last revision date",
      "note": "Replace {{VA_FORMS_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "https://sandbox-api.va.gov/services/va_forms/{{VERSION}}/forms"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{VA_FORMS_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{VA_FORMS_API_KEY}}"
      },
      "method": "GET",
      "name": "Find form by form name",
      "note": "Replace {{VA_FORMS_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "https://sandbox-api.va.gov/services/va_forms/{{VERSION}}/forms/{{FORM_NAME}}"
    }
  ]
}
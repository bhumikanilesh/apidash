{
  "id": "cowin.gov.cin_cowincert",
  "info": {
    "base_url": "https://cowin.gov.cin/cert/external",
    "description": "Co-WIN Certificate API provides Other capabilities via REST API.",
    "source": "apis.guru",
    "tags": [
      "other"
    ],
    "title": "Co-WIN Certificate API",
    "version": "1.0.0"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {
        "beneficiaryId": "",
        "mobile": ""
      },
      "body_json": {
        "beneficiaryId": "",
        "mobile": ""
      },
      "body_text": "{\"beneficiaryId\": \"\", \"mobile\": \"\"}",
      "body_type": "json",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "Authorization",
          "value": "Bearer {{COWIN_CERTIFICATE_API_KEY_ACCESS_TOKEN}}"
        },
        {
          "enabled": true,
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "headers": {
        "Authorization": "Bearer {{COWIN_CERTIFICATE_API_KEY_ACCESS_TOKEN}}",
        "Content-Type": "application/json"
      },
      "method": "POST",
      "name": "Download the certificate in pdf format",
      "note": "Replace {{COWIN_CERTIFICATE_API_KEY}} with your API key",
      "url": "https://cowin.gov.cin/cert/external/pdf/certificate"
    }
  ]
}
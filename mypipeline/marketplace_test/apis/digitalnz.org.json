{
  "id": "digitalnz.org",
  "info": {
    "base_url": "https://api.digitalnz.org",
    "description": "This feature returns a set of search results that are similar (ie have similar metadata) to a specific record.",
    "source": "apis.guru",
    "tags": [
      "embedding"
    ],
    "title": "DigitalNZ API",
    "version": "3"
  },
  "requests": [
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{DIGITALNZ_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{DIGITALNZ_API_KEY}}"
      },
      "method": "GET",
      "name": "Run queries against DigitalNZ metadata search service.",
      "note": "Replace {{DIGITALNZ_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "https://api.digitalnz.org/records.{{FORMAT}}"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{DIGITALNZ_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{DIGITALNZ_API_KEY}}"
      },
      "method": "GET",
      "name": "View metadata associated with a single record.",
      "note": "Replace {{DIGITALNZ_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "https://api.digitalnz.org/records/{{RECORD_ID}}.{{FORMAT}}"
    },
    {
      "auth": {
        "type": "none"
      },
      "body": {},
      "body_json": null,
      "body_text": "",
      "body_type": "none",
      "form_data": [],
      "header_rows": [
        {
          "enabled": true,
          "name": "X-API-Key",
          "value": "{{DIGITALNZ_API_KEY}}"
        }
      ],
      "headers": {
        "X-API-Key": "{{DIGITALNZ_API_KEY}}"
      },
      "method": "GET",
      "name": "The \"More Like This\" call returns similar records to the specified ID.\n",
      "note": "Replace {{DIGITALNZ_API_KEY}} with your API key | Replace path parameters (e.g. {{VOICE_ID}}) with actual values",
      "url": "https://api.digitalnz.org/records/{{RECORD_ID}}/more_like_this.{{FORMAT}}"
    }
  ]
}